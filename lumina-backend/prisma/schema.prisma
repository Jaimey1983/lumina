generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                 @id @default(cuid())
  email                   String                 @unique
  password                String
  name                    String
  lastName                String
  role                    Role                   @default(STUDENT)
  avatar                  String?
  isActive                Boolean                @default(true)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  institution             String?
  classResults            ClassResult[]
  classGuests             ClassGuest[]
  teacherCourses          Course[]               @relation("TeacherCourses")
  enrollments             Enrollment[]
  gradebookEntries        GradeEntry[]
  classProgress           StudentClassProgress[]
  messageReads            MessageRead[]
  receivedMessages        Message[]              @relation("ReceivedMessages")
  sentMessages            Message[]              @relation("SentMessages")
  peerEvaluationsReceived PeerEvaluation[]       @relation("EvaluatedUser")
  peerEvaluationsGiven    PeerEvaluation[]       @relation("EvaluatorUser")
  selfEvaluations         SelfEvaluation[]
  studentBadges           StudentBadge[]
  studentPoints           StudentPoints[]
  workGroupMemberships    WorkGroupMember[]
  preferredAiProvider     AiProvider?
  teacherAiKeys           TeacherAiKey[]
  passwordResetTokens     PasswordResetToken[]

  // ─── SUPERADMIN / verificación docente (PR1: solo estructura) ──────────────
  // Soft delete. Requiere filtrar `deletedAt: null` en TODAS las queries de
  // usuario del backend (cambio transversal — se aplica en PR3).
  deletedAt             DateTime?
  // Verificación: aplica sólo a TEACHER / TEACHER_ASSISTANT. Sin `@default` a
  // propósito — se setea en el registro para roles docentes (PR2); un
  // STUDENT/PARENT/ADMIN queda en NULL = "no aplica".
  verificationStatus    VerificationStatus?
  verificationMethod    VerificationMethod?
  verificationExpiresAt DateTime?
  institutionalEmail    String?
  verifiedAt            DateTime?
  verifiedById          String?
  verifiedBy            User?               @relation("UserVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedUsers         User[]              @relation("UserVerifiedBy")
  rejectionReason       String?
  // Documento manual: reservado para fase 2. `documentUrl` guardará la CLAVE de
  // almacenamiento / referencia a URL firmada — nunca el archivo en base64.
  documentType          String?
  documentUrl           String?
  documentIssuedAt      DateTime?

  invitationCodesCreated  InvitationCode[]            @relation("InvitationCreatedBy")
  invitationCodesUsed     InvitationCode[]            @relation("InvitationUsedBy")
  adminAuditLogsMade      AdminAuditLog[]             @relation("AuditAdmin")
  adminAuditLogsReceived  AdminAuditLog[]             @relation("AuditTarget")
  impersonationsMade      AdminImpersonationSession[] @relation("ImpersonationAdmin")
  impersonationsReceived  AdminImpersonationSession[] @relation("ImpersonationTarget")
  learningEventsAsActor   LearningEvent[]             @relation("LearningEventActor")
  learningEventsAsStudent LearningEvent[]             @relation("LearningEventStudent")
  learningEventsAsTeacher LearningEvent[]             @relation("LearningEventTeacher")
  researchConsent         ResearchConsent?

  @@index([deletedAt])
  @@index([role, verificationStatus])
  @@map("users")
}

/// Token de restablecimiento de contraseña ("olvidé mi contraseña").
/// Se guarda sólo el hash SHA-256 del token; el valor en claro viaja una única
/// vez al usuario (por correo en producción). Un solo uso (`usedAt`) y
/// expiración corta (`expiresAt`). Pedir un token nuevo invalida los anteriores.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Clave BYOK de un docente (cifrada). Nunca se expone en claro por la API.
model TeacherAiKey {
  id             String     @id @default(cuid())
  userId         String
  provider       AiProvider
  encryptedKey   String
  keyHint        String
  lastVerifiedAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("teacher_ai_keys")
}

model Course {
  id                 String                 @id @default(cuid())
  name               String
  description        String?
  code               String                 @unique
  isActive           Boolean                @default(true)
  teacherId          String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  achievements       Achievement[]
  badges             Badge[]
  classes            Class[]
  teacher            User                   @relation("TeacherCourses", fields: [teacherId], references: [id])
  enrollments        Enrollment[]
  forums             Forum[]
  gradebookStructure GradebookStructure?
  messages           Message[]
  periods            Period[]
  studentPoints      StudentPoints[]
  workGroups         WorkGroup[]
  /**
   * Grafo del mapa de progreso (edges). Layout de nodos es v2.
   */
  progressMap        Json?
  classProgress      StudentClassProgress[]

  @@map("courses")
}

model Period {
  id           String        @id @default(cuid())
  name         String
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean       @default(true)
  courseId     String
  createdAt    DateTime      @default(now())
  achievements Achievement[]
  gradeEntries GradeEntry[]
  course       Course        @relation(fields: [courseId], references: [id])

  @@map("periods")
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
  @@map("enrollments")
}

enum ProgressStatus {
  LOCKED
  UNLOCKED
  IN_PROGRESS
  COMPLETED
}

/**
 * Completitud canónica por estudiante × clase (mapa de progreso Edu).
 */
model StudentClassProgress {
  id          String         @id @default(cuid())
  userId      String
  classId     String
  courseId    String
  status      ProgressStatus @default(COMPLETED)
  completedAt DateTime?
  unlockedAt  DateTime?
  score       Float?
  source      String         @default("manual_teacher")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  class  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, classId])
  @@index([userId, courseId])
  @@map("student_class_progress")
}

model Class {
  id                 String                 @id @default(cuid())
  title              String
  description        String?
  code               String                 @unique
  status             ClassStatus            @default(DRAFT)
  /**
   * `clase` = docente controla diapositivas; `presentacion` = estudiante a su ritmo sin telemetría; `autonomo` = ritmo propio con progreso en vivo.
   */
  modoEntrega        String                 @default("clase")
  /**
   * Segundos por defecto del temporizador en vivo (0 = desactivado).
   */
  timerGlobal        Int                    @default(0)
  courseId           String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  desempeno          Json?
  codigo             String                 @unique @default(cuid())
  /**
   * Id del fondo del canvas en viewer (`none`, `blanco`, …).
   */
  background         String?                @default("none")
  results            ClassResult[]
  guests             ClassGuest[]
  sessions           ClassSession[]
  course             Course                 @relation(fields: [courseId], references: [id])
  collabNotes        CollabNote[]
  slides             Slide[]
  whiteboardSessions WhiteboardSession[]
  autonomousSessions AutonomousSession[]
  autonomousGrades   AutonomousGrade[]
  studentProgress    StudentClassProgress[]

  @@map("classes")
}

model AutonomousSession {
  id                 String               @id @default(cuid())
  classId            String
  class              Class                @relation(fields: [classId], references: [id])
  teacherId          String
  opensAt            DateTime
  closesAt           DateTime
  allowBackNav       Boolean              @default(true)
  maxAttempts        Int                  @default(1)
  timerBehavior      String               @default("advance")
  requireManualStart Boolean              @default(false)
  pin                String               @default("")
  status             String               @default("scheduled")
  /**
   * "recovery" | "independent"
   */
  purpose            String               @default("independent")
  createdAt          DateTime             @default(now())
  progress           AutonomousProgress[]
  results            AutonomousResult[]
  grades             AutonomousGrade[]

  @@map("autonomous_sessions")
}

model AutonomousGrade {
  id          String            @id @default(cuid())
  sessionId   String
  session     AutonomousSession @relation(fields: [sessionId], references: [id])
  classId     String
  class       Class             @relation(fields: [classId], references: [id])
  studentId   String
  studentName String
  score       Float
  source      String            @default("autonomous")
  completedAt DateTime          @default(now())
  createdAt   DateTime          @default(now())

  @@map("autonomous_grades")
}

model AutonomousProgress {
  id            String            @id @default(cuid())
  sessionId     String
  session       AutonomousSession @relation(fields: [sessionId], references: [id])
  studentId     String
  studentName   String
  slideId       String
  response      Json?
  answeredAt    DateTime          @default(now())
  attemptNumber Int               @default(1)
  activityType  String?
  score         Float?

  @@map("autonomous_progress")
}

model AutonomousResult {
  id            String            @id @default(cuid())
  sessionId     String
  session       AutonomousSession @relation(fields: [sessionId], references: [id])
  studentId     String
  studentName   String
  attemptNumber Int               @default(1)
  status        String            @default("in_progress")
  finalScore    Float?
  completedAt   DateTime?
  createdAt     DateTime          @default(now())

  @@map("autonomous_results")
}

model Slide {
  id             String         @id @default(cuid())
  order          Int
  type           SlideType
  title          String
  content        Json?
  classId        String
  /**
   * Versión monotónica del contenido. Cada update exitoso hace increment 1.
   * Clientes que envían `expectedVersion` obtienen 409 si no coincide (optimistic locking).
   */
  contentVersion Int            @default(0)
  createdAt      DateTime       @default(now())
  class          Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  versions       SlideVersion[]

  @@map("slides")
}

model SlideVersion {
  id        String   @id @default(cuid())
  slideId   String
  slide     Slide    @relation(fields: [slideId], references: [id], onDelete: Cascade)
  content   Json
  createdAt DateTime @default(now())

  @@index([slideId, createdAt])
  @@map("slide_versions")
}

model ClassSession {
  id          String        @id @default(cuid())
  classId     String
  startedAt   DateTime      @default(now())
  endedAt     DateTime?
  activeSlide Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  class       Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  results     ClassResult[]
  sessionLog  SessionLog?

  @@map("class_sessions")
}

// ─── ANALYTICS SESIÓN EN VIVO ─────────────────────────────────────────

model SessionLog {
  id              String    @id @default(cuid())
  sessionId       String    @unique
  classId         String
  courseId        String
  teacherId       String
  totalSlides     Int       @default(0)
  peakConnections Int       @default(0)
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int?
  createdAt       DateTime  @default(now())

  session          ClassSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  slideEngagements SlideEngagement[]

  @@map("session_logs")
}

model StudentConnection {
  id             String    @id @default(cuid())
  sessionId      String
  classId        String
  studentId      String
  studentName    String
  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?
  reconnections  Int       @default(0)

  @@index([sessionId, studentId])
  @@map("student_connections")
}

model SlideEngagement {
  id            String   @id @default(cuid())
  sessionLogId  String
  slideId       String
  slideIndex    Int
  activityType  String?
  studentId     String
  studentName   String
  timeOnSlide   Int      @default(0)
  responded     Boolean  @default(false)
  attemptNumber Int      @default(1)
  source        String   @default("live")
  createdAt     DateTime @default(now())

  sessionLog SessionLog @relation(fields: [sessionLogId], references: [id], onDelete: Cascade)

  @@unique([sessionLogId, slideId, studentId])
  @@map("slide_engagements")
}

model ClassResult {
  id           String       @id @default(cuid())
  classId      String
  studentId    String
  slideId      String
  activityType String
  score        Float?
  maxScore     Float        @default(5)
  isManual     Boolean      @default(false)
  response     Json?
  sessionId    String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  student      User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session      ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId, slideId, sessionId])
  @@map("class_results")
}

/**
 * Vínculo guest ↔ clase al hacer joinAsGuest (Fase 7.3). No es matrícula de curso.
 */
model ClassGuest {
  id        String   @id @default(cuid())
  classId   String
  userId    String
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@map("class_guests")
}

model GradebookStructure {
  id       String   @id @default(cuid())
  courseId String   @unique
  aspects  Aspect[]
  course   Course   @relation(fields: [courseId], references: [id])

  @@map("gradebook_structures")
}

model Aspect {
  id           String             @id @default(cuid())
  name         String
  weight       Float
  structureId  String
  achievements Achievement[]
  structure    GradebookStructure @relation(fields: [structureId], references: [id])

  @@map("aspects")
}

model Achievement {
  id                    String                 @id @default(cuid())
  code                  String
  statement             String
  scope                 AchievementScope       @default(SPECIFIC)
  courseId              String
  aspectId              String
  periodId              String
  createdAt             DateTime               @default(now())
  aspect                Aspect                 @relation(fields: [aspectId], references: [id])
  course                Course                 @relation(fields: [courseId], references: [id])
  period                Period                 @relation(fields: [periodId], references: [id])
  performanceIndicators PerformanceIndicator[]

  @@unique([code, courseId])
  @@map("achievements")
}

model PerformanceIndicator {
  id              String          @id @default(cuid())
  statement       String
  competenceType  CompetenceType
  competenceScope CompetenceScope @default(GENERAL)
  subject         String?
  weight          Float
  achievementId   String
  createdAt       DateTime        @default(now())
  activities      Activity[]
  achievement     Achievement     @relation(fields: [achievementId], references: [id])

  @@map("performance_indicators")
}

model Activity {
  id                     String               @id @default(cuid())
  name                   String
  weight                 Float
  maxScore               Float                @default(5.0)
  performanceIndicatorId String
  performanceIndicator   PerformanceIndicator @relation(fields: [performanceIndicatorId], references: [id])
  gradeEntries           GradeEntry[]
  groupActivities        GroupActivity[]

  @@map("activities")
}

model GradeEntry {
  id         String   @id @default(cuid())
  score      Float
  feedback   String?
  userId     String
  activityId String
  periodId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  activity   Activity @relation(fields: [activityId], references: [id])
  period     Period   @relation(fields: [periodId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, activityId, periodId])
  @@map("grade_entries")
}

model SelfEvaluation {
  id        String   @id @default(cuid())
  score     Float
  feedback  String?
  userId    String
  courseId  String
  periodId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, courseId, periodId])
  @@map("self_evaluations")
}

model PeerEvaluation {
  id          String   @id @default(cuid())
  score       Float
  feedback    String?
  evaluatorId String
  evaluatedId String
  courseId    String
  periodId    String
  createdAt   DateTime @default(now())
  evaluated   User     @relation("EvaluatedUser", fields: [evaluatedId], references: [id])
  evaluator   User     @relation("EvaluatorUser", fields: [evaluatorId], references: [id])

  @@unique([evaluatorId, evaluatedId, courseId, periodId])
  @@map("peer_evaluations")
}

model StudentPoints {
  id        String   @id @default(cuid())
  points    Int      @default(0)
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reason    String?
  course    Course   @relation(fields: [courseId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
  @@map("student_points")
}

model Badge {
  id          String         @id @default(cuid())
  name        String
  description String?
  icon        String?
  isActive    Boolean        @default(true)
  courseId    String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  course      Course         @relation(fields: [courseId], references: [id])
  assignments StudentBadge[]

  @@map("badges")
}

model StudentBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, badgeId])
  @@map("student_badges")
}

model Message {
  id          String        @id @default(cuid())
  content     String
  isDeleted   Boolean       @default(false)
  courseId    String
  senderId    String
  recipientId String?
  parentId    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  reads       MessageRead[]
  course      Course        @relation(fields: [courseId], references: [id])
  parent      Message?      @relation("MessageReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies     Message[]     @relation("MessageReplies")
  recipient   User?         @relation("ReceivedMessages", fields: [recipientId], references: [id])
  sender      User          @relation("SentMessages", fields: [senderId], references: [id])

  @@map("messages")
}

model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
  @@map("message_reads")
}

model Webhook {
  id          String       @id @default(cuid())
  name        String
  url         String
  secret      String?
  events      String[]
  isActive    Boolean      @default(true)
  courseId    String?
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  logs        WebhookLog[]

  @@map("webhooks")
}

model WebhookLog {
  id         String   @id @default(cuid())
  webhookId  String
  event      String
  payload    Json
  statusCode Int?
  response   String?
  success    Boolean
  sentAt     DateTime @default(now())
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@map("webhook_logs")
}

model Forum {
  id          String        @id @default(cuid())
  name        String
  description String?
  isActive    Boolean       @default(true)
  courseId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  threads     ForumThread[]
  course      Course        @relation(fields: [courseId], references: [id])

  @@map("forums")
}

model ForumThread {
  id        String       @id @default(cuid())
  title     String
  body      String
  isPinned  Boolean      @default(false)
  isLocked  Boolean      @default(false)
  isActive  Boolean      @default(true)
  forumId   String
  authorId  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  replies   ForumReply[]
  forum     Forum        @relation(fields: [forumId], references: [id], onDelete: Cascade)

  @@map("forum_threads")
}

model ForumReply {
  id        String      @id @default(cuid())
  body      String
  isActive  Boolean     @default(true)
  threadId  String
  authorId  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@map("forum_replies")
}

model WhiteboardSession {
  id          String   @id @default(cuid())
  name        String
  content     Json?
  isActive    Boolean  @default(true)
  classId     String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("whiteboard_sessions")
}

model CollabNote {
  id          String        @id @default(cuid())
  title       String
  content     Json?
  isActive    Boolean       @default(true)
  classId     String
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  class       Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  versions    NoteVersion[]

  @@map("collab_notes")
}

model NoteVersion {
  id        String     @id @default(cuid())
  content   Json
  noteId    String
  authorId  String
  createdAt DateTime   @default(now())
  note      CollabNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("note_versions")
}

model WorkGroup {
  id          String            @id @default(cuid())
  name        String
  description String?
  isActive    Boolean           @default(true)
  courseId    String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  activities  GroupActivity[]
  members     WorkGroupMember[]
  course      Course            @relation(fields: [courseId], references: [id])

  @@map("work_groups")
}

model WorkGroupMember {
  id       String    @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime  @default(now())
  group    WorkGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@map("work_group_members")
}

model GroupActivity {
  id         String    @id @default(cuid())
  groupId    String
  activityId String
  assignedAt DateTime  @default(now())
  activity   Activity  @relation(fields: [activityId], references: [id])
  group      WorkGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, activityId])
  @@map("group_activities")
}

model TorneoSession {
  id        String   @id @default(cuid())
  classId   String
  sessionId String
  status    String   @default("waiting")
  currentQ  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("torneo_sessions")
}

model TorneoAnswer {
  id            String   @id @default(cuid())
  torneoId      String
  studentId     String
  studentName   String
  questionIndex Int
  answer        String
  correct       Boolean
  responseMs    Int
  points        Int
  createdAt     DateTime @default(now())

  @@unique([torneoId, questionIndex, studentId])
  @@map("torneo_answers")
}

// ─── ESCAPE ROOM — ESTADO DE EJECUCIÓN EN VIVO ────────────────────────────
// El DISEÑO (salas, desafíos, pistas) vive en `Slide.content` como contenido de
// autoría. Estas tablas solo guardan la PARTIDA: equipos y su progreso.
// `studentId` no lleva FK a User a propósito, igual que TorneoAnswer: así sirve
// tanto a estudiantes matriculados como a invitados del join.

model EscapeRoomRun {
  id        String    @id @default(cuid())
  classId   String
  /**
   * ClassSession.id — la partida vive dentro de una sesión en vivo.
   */
  sessionId String
  slideId   String
  status    String    @default("running")
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  teams EscapeRoomTeam[]

  @@unique([sessionId, slideId])
  @@index([classId])
  @@map("escape_room_runs")
}

model EscapeRoomTeam {
  id         String    @id @default(cuid())
  runId      String
  name       String
  /**
   * Índice de la sala en la que va el equipo (avance compartido).
   */
  salaIndex  Int       @default(0)
  points     Int       @default(0)
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  run     EscapeRoomRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  members EscapeRoomTeamMember[]
  rooms   EscapeRoomTeamRoom[]

  @@unique([runId, name])
  @@map("escape_room_teams")
}

model EscapeRoomTeamMember {
  id          String   @id @default(cuid())
  teamId      String
  /**
   * Denormalizado para garantizar un solo equipo por partida.
   */
  runId       String
  studentId   String
  studentName String
  joinedAt    DateTime @default(now())

  team EscapeRoomTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([runId, studentId])
  @@index([teamId])
  @@map("escape_room_team_members")
}

model EscapeRoomTeamRoom {
  id                  String   @id @default(cuid())
  teamId              String
  salaId              String
  salaIndex           Int
  /**
   * abierta | superada | agotada
   */
  status              String   @default("abierta")
  intentos            Int      @default(0)
  pistasReveladas     Int      @default(0)
  points              Int      @default(0)
  solvedByStudentId   String?
  solvedByStudentName String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  team EscapeRoomTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, salaId])
  @@map("escape_room_team_rooms")
}

// ══════════════════════════════════════════════════════════════════════════════
// SUPERADMIN — PR1: solo estructura, sin lógica de negocio todavía.
// Ver SUPERADMIN_CONTEXT (v2). `role` usa el enum `Role` YA EXISTENTE — no tocar.
// ══════════════════════════════════════════════════════════════════════════════

/// Código que da acceso docente completo pero temporal (30 días) hasta verificar
/// por otra vía. `revokedAt` desactiva un código filtrado sin perder la traza.
model InvitationCode {
  id          String    @id @default(cuid())
  code        String    @unique
  targetRole  Role      @default(TEACHER)
  createdById String
  createdBy   User      @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  usedById    String?
  usedBy      User?     @relation("InvitationUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime?
  maxUses     Int       @default(1)
  usedCount   Int       @default(0)
  revokedAt   DateTime?
  note        String?
  createdAt   DateTime  @default(now())

  @@index([createdById])
  @@map("invitation_codes")
}

/// Dominio de correo que auto-verifica (vía rápida, no requisito).
model TrustedDomain {
  id         String   @id @default(cuid())
  domain     String   @unique
  autoVerify Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("trusted_domains")
}

/// Log inmutable de toda acción SUPERADMIN sensible. `action` sigue un catálogo
/// versionado documentado en código (`src/superadmin/audit.constants.ts`).
model AdminAuditLog {
  id           String   @id @default(cuid())
  adminId      String
  admin        User     @relation("AuditAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  action       String
  targetUserId String?
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  metadata     Json?
  timestamp    DateTime @default(now())

  @@index([adminId, timestamp])
  @@index([targetUserId, timestamp])
  @@index([action, timestamp])
  @@map("admin_audit_logs")
}

/// Sesión de impersonación: fuente de verdad de revocación (guard: `endedAt IS
/// NULL AND jti` coincide) y registro de auditoría. Usada por PR4. `targetUserId`
/// opcional para permitir hard-delete del usuario (Habeas Data) sin perder la fila.
model AdminImpersonationSession {
  id           String    @id @default(cuid())
  jti          String    @unique
  adminId      String
  admin        User      @relation("ImpersonationAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  targetUserId String?
  targetUser   User?     @relation("ImpersonationTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  ip           String?
  userAgent    String?

  @@index([adminId, startedAt])
  @@index([targetUserId])
  @@map("admin_impersonation_sessions")
}

/// Event sourcing ligero para learning analytics doctoral. Log inmutable; se
/// agrega al CONSULTAR. `eventType` sigue un catálogo versionado; `payloadVersion`
/// versiona `payload`. FK a User con `onDelete: SetNull` (no borrar la historia
/// al borrar el usuario; el hard-delete por Habeas Data es ruta aparte).
/// `classId`/`courseId`/`activityId` son dimensiones analíticas, no FK enforced.
model LearningEvent {
  id             String   @id @default(cuid())
  timestamp      DateTime @default(now())
  eventType      String
  payloadVersion Int      @default(1)
  actorUserId    String?
  actorUser      User?    @relation("LearningEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  studentId      String?
  student        User?    @relation("LearningEventStudent", fields: [studentId], references: [id], onDelete: SetNull)
  teacherId      String?
  teacher        User?    @relation("LearningEventTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  classId        String?
  courseId       String?
  activityId     String?
  activityType   String?
  subjectArea    String?
  gradeLevel     String?
  payload        Json
  aiProvider     String?
  aiEdited       Boolean?
  studyPhase     String?

  @@index([eventType, timestamp])
  @@index([actorUserId, timestamp])
  @@index([studentId])
  @@index([teacherId])
  @@index([activityId])
  @@index([teacherId, eventType, timestamp])
  @@map("learning_events")
}

/// Agregados diarios (job cron de fase posterior) para que el dashboard no
/// recalcule sobre eventos crudos.
model DailyMetricSnapshot {
  id         String   @id @default(cuid())
  date       DateTime
  scope      String
  metricKey  String
  value      Float
  sampleSize Int?

  @@unique([date, scope, metricKey])
  @@map("daily_metric_snapshots")
}

/// Consentimiento opt-in explícito por usuario. Si `consentStatus != "granted"`
/// el usuario queda excluido de todo export. `consentVersion` referencia el
/// texto/URL inmutable de esa versión.
model ResearchConsent {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userType       String
  consentStatus  String
  consentDate    DateTime?
  revokedDate    DateTime?
  scope          String
  consentVersion String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("research_consents")
}

/// Job de export filtrado por consentimiento y anonimizado. Funcional en fase posterior.
model ResearchExportJob {
  id            String   @id @default(cuid())
  requestedAt   DateTime @default(now())
  filters       Json
  anonymization String
  status        String
  fileUrl       String?

  @@map("research_export_jobs")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  EXPIRED
  REJECTED
}

enum VerificationMethod {
  INVITATION_CODE
  MANUAL_DOCUMENT // reservado para fase 2; no usado en el MVP
  INSTITUTIONAL_EMAIL
}

