# App
PORT=3000
NODE_ENV=development

# Base de datos — DATABASE_URL apunta al PostgreSQL local de Windows (puerto 5432).
# Alternativa si usas solo el contenedor lumina_postgres (mapeado a 5434 en el host):
# DATABASE_URL_DOCKER="postgresql://lumina:lumina1234@localhost:5434/lumina"
DATABASE_URL="postgresql://lumina:lumina1234@localhost:5432/lumina"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=lumina_super_secret_key_2025_cambiar_en_produccion
JWT_EXPIRES_IN=7d

# Frontend
FRONTEND_URL=http://localhost:3001

# IA — Google Gemini de plataforma (fallback si el docente no trae su clave).
# También la usan CurriculumModule y AchievementsModule (aún no son BYOK).
GEMINI_API_KEY=your_key_here

# Cifrado de claves BYOK (AES-256-GCM + HKDF). Obligatorio para guardar/usar claves propias.
# Mínimo 32 caracteres aleatorios. Nunca uses un placeholder.
# Ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_KEYS_MASTER_SECRET=genera_un_secreto_aleatorio_de_al_menos_32_chars
