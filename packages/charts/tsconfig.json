{
  // moduleResolution Bundler + serve-from-dist (patrón @lumina/ui / @lumina/editor-shared):
  // arrastra @lumina/ui + apexcharts; Bundler resuelve igual que el propio frontend.
  // Los imports relativos llevan .js (dist/ emitido = ESM válido para Turbopack).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
