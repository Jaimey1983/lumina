{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "declaration": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "../../lumina-frontend/src/*"
      ],
      "lumina-frontend/blocks/grafico": [
        "./src/shims/lumina-frontend-grafico.d.ts"
      ],
      "lumina-frontend/blocks/diagrama": [
        "./src/shims/lumina-frontend-diagrama.d.ts"
      ],
      "lumina-frontend/blocks/clip-group": [
        "./src/shims/lumina-frontend-clip-group.d.ts"
      ],
      "lumina-frontend/blocks/clip-group/paper": [
        "./src/shims/lumina-frontend-clip-group-paper.d.ts"
      ],
      "lumina-frontend/blocks/texto": [
        "./src/shims/lumina-frontend-texto.d.ts"
      ],
      "lumina-frontend/blocks/imagen": [
        "./src/shims/lumina-frontend-imagen.d.ts"
      ],
      "lumina-frontend/blocks/video": [
        "./src/shims/lumina-frontend-video.d.ts"
      ],
      "lumina-frontend/blocks/audio": [
        "./src/shims/lumina-frontend-audio.d.ts"
      ],
      "lumina-frontend/blocks/codigo": [
        "./src/shims/lumina-frontend-codigo.d.ts"
      ],
      "lumina-frontend/blocks/cita": [
        "./src/shims/lumina-frontend-cita.d.ts"
      ],
      "lumina-frontend/blocks/separador": [
        "./src/shims/lumina-frontend-separador.d.ts"
      ],
      "lumina-frontend/blocks/columnas": [
        "./src/shims/lumina-frontend-columnas.d.ts"
      ],
      "lumina-frontend/editor-activities": [
        "../../lumina-frontend/src/app/(app)/classes/[id]/editor/element-kit-classic.ts"
      ],
      "@lumina/element-kit/widgets/*": [
        "./src/widgets/*"
      ],
      "@lumina/element-kit/activities/*": [
        "./src/activities/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts"
  ]
}
