{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "declaration": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "../../lumina-frontend/src/*"
      ],
      "@lumina/element-kit/widgets/*": [
        "./src/widgets/*"
      ],
      "@lumina/element-kit/activities/*": [
        "./src/activities/*"
      ],
      "@lumina/element-kit/blocks/*": [
        "./src/blocks/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts"
  ]
}
