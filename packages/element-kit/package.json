{
  "name": "@lumina/element-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./widgets/*": {
      "types": "./dist/widgets/*.d.ts",
      "default": "./dist/widgets/*.js"
    },
    "./widgets/*.css": "./dist/widgets/*.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "test": "tsc --noEmit && vitest run",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@lumina/editor-shared": "workspace:*",
    "@lumina/element-kit-core": "workspace:*",
    "@lumina/scoring": "workspace:*",
    "@lumina/types": "workspace:*",
    "@lumina/ui": "workspace:*",
    "lucide-react": "^1.7.0",
    "lumina-frontend": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "jsdom": "^26.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
