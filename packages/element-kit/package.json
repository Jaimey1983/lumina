{
  "name": "@lumina/element-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./widgets/*": {
      "types": "./dist/widgets/*.d.ts",
      "default": "./dist/widgets/*.js"
    },
    "./widgets/*.css": "./dist/widgets/*.css",
    "./activities/*": {
      "types": "./dist/activities/*.d.ts",
      "default": "./dist/activities/*.js"
    },
    "./activities/*.css": "./dist/activities/*.css",
    "./blocks/*": {
      "types": "./dist/blocks/*.d.ts",
      "default": "./dist/blocks/*.js"
    },
    "./blocks/*.css": "./dist/blocks/*.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "test": "tsc --noEmit && vitest run",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lumina/editor-shared": "workspace:*",
    "@lumina/element-kit-core": "workspace:*",
    "@lumina/scoring": "workspace:*",
    "@lumina/types": "workspace:*",
    "@lumina/ui": "workspace:*",
    "katex": "0.16.11",
    "lucide-react": "^1.7.0",
    "paper": "0.12.18",
    "recharts": "^2.15.1",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@types/katex": "0.16.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "jsdom": "^26.1.0",
    "next": "15.5.19",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
