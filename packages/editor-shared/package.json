{
  "name": "@lumina/editor-shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "//": "Substrato compartido del editor: widgets/shared + helpers de tipografia/fuentes + path helpers de Block (E7.6.3-pre) + graph-editor (xyflow wrapper, E7.6.4a). Lo consumen lumina-frontend y (transitivamente) @lumina/element-kit. Consumido desde dist/ (patron @lumina/ui).",
  "exports": {
    "./graph-editor": {
      "types": "./dist/graph-editor/index.d.ts",
      "default": "./dist/graph-editor/index.js"
    },
    "./rich-text": {
      "types": "./dist/rich-text/index.d.ts",
      "default": "./dist/rich-text/index.js"
    },
    "./*.css": "./dist/*.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "test": "tsc --noEmit && vitest run",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@lumina/types": "workspace:*",
    "@lumina/ui": "workspace:*",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-bold": "3.31.3",
    "@tiptap/extension-color": "3.31.3",
    "@tiptap/extension-highlight": "3.31.3",
    "@tiptap/extension-italic": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-strike": "3.31.3",
    "@tiptap/extension-subscript": "3.31.3",
    "@tiptap/extension-superscript": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@xyflow/react": "12.11.0",
    "lucide-react": "^1.7.0",
    "opentype.js": "^1.3.4"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
